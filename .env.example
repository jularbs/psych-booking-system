# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# --- Postgres ---
POSTGRES_DB=psych_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
CORS_ORIGIN=http://localhost:4200

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_a_long_random_refresh_secret
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# --- Google Calendar ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/google-calendar/oauth/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar.calendarlist.readonly,https://www.googleapis.com/auth/calendar.freebusy
APP_BASE_URL=http://localhost:4200