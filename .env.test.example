NODE_ENV=test
PORT=3001
CORS_ORIGIN=http://localhost:4200
DATABASE_URL=postgres://postgres:postgres@localhost:5432/psych_booking_test
JWT_SECRET=test-access-secret-please-change
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=test-refresh-secret-please-change
JWT_REFRESH_TTL=7d

# --- Google Calendar ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/google-calendar/oauth/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar.calendarlist.readonly,https://www.googleapis.com/auth/calendar.freebusy
